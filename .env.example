# =================================
# SERVER CONFIGURATION
# =================================
NODE_ENV=development
PORT=5000

# =================================
# DATABASE CONFIGURATION
# =================================
# MongoDB connection string (local or MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/rental-management
# Database name - must match your MongoDB database name
DATABASE_NAME=rental-management

# =================================
# AUTHENTICATION & SECURITY
# =================================
# Bcrypt salt rounds for password hashing (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# JWT Secret Keys - Use strong random strings in production
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT Token Expiration
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=365d

# Default & Admin Passwords
DEFAULT_PASS=defaultPassword123
SUPER_ADMIN_PASSWORD=admin12345

# Password Reset UI Link (Frontend URL)
RESET_PASS_UI_LINK=http://localhost:3000/reset-password

# =================================
# CLOUDINARY CONFIGURATION
# =================================
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =================================
# STRIPE PAYMENT CONFIGURATION
# =================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =================================
# EMAIL CONFIGURATION (NODEMAILER)
# =================================
# SMTP Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
# For Gmail: Generate App Password from Google Account settings
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@rental-management.com

# =================================
# FRONTEND URLS (FOR CORS)
# =================================
# Add all frontend URLs that need API access
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://findbasa.vercel.app

# =================================
# OPTIONAL CONFIGURATION
# =================================
# Maximum file upload size (in MB)
MAX_FILE_SIZE=5
# Maximum number of property images
MAX_IMAGES=4